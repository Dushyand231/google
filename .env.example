# Supabase project. Dashboard -> Project Settings -> API.
# The project URL and anon key are NOT what the server needs: the server uses
# the service_role key, which bypasses Row Level Security. Never put that key
# in src/ or anywhere the Expo app bundles -- it would ship to every phone.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Not a secret: the anon key is designed to ship inside the client app, which
# is exactly why the schema has to deny it everything via RLS. Only used by
# scripts/verify-supabase.mjs to prove that denial actually holds.
SUPABASE_ANON_KEY=your-anon-key

# One-time setup: paste db/schema.sql into Supabase -> SQL Editor and Run.
# `npm run server` then checks all 9 tables and names anything still missing.

SYNC_PORT=4000
# Shared secret for the demo auth endpoint. Not a production credential.
API_TOKEN_SECRET=jeevacare-dev-secret
